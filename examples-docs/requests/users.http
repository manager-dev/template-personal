### Petición 1: Iniciar Sesión (Login)
# Enviamos las credenciales al servidor para obtener un token
POST {{url_base}}/v1/auth/login
Content-Type: application/json

{
  "username": "usuario_ejemplo",
  "password": "mi_password_secreto"
}

# ⬇️ AQUÍ EMPIEZA EL SCRIPT JAVASCRIPT (Se ejecuta justo cuando llega la respuesta)
> {%
    // 1. Verificar si el servidor respondió con un estado exitoso (200 OK)
    client.test("Login exitoso", function() {
        client.assert(response.status === 200, "El servidor no devolvió un código 200");
    });

    // 2. Extraer el token del cuerpo de la respuesta (asumiendo que responde un JSON)
    // Ejemplo de respuesta: { "token": "abcde12345...", "expires_in": 3600 }
    var tokenRecibido = response.body.token;

    // 3. Guardar el token en la memoria global de JetBrains bajo el nombre 'auth_token'
    client.global.set("auth_token", tokenRecibido);

    // Opcional: Imprimir un mensaje en la consola del IDE para confirmar que funcionó
    client.log("¡Token capturado con éxito!: " + tokenRecibido);
%}

###

### Petición 2: Consultar datos protegidos (Usa el token capturado automáticamente)
# Al usar {{auth_token}}, el IDE inyectará el valor que el script guardó arriba
GET {{url_base}}/v1/dashboard/metrics
Accept: application/json
Authorization: Bearer {{auth_token}}
